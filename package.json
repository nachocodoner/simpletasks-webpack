{
  "name": "simpletasks",
  "author": "@fredmaiaarantes",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "start:meteor": "meteor run",
    "start:vite:client": "TARGET=client vite build --config=vite.config.js --mode=development",
    "start:vite:server": "TARGET=server vite build --config=vite.config.js --mode=development",
    "start:vite": "concurrently -n start:vite:client,start:vite:server \"meteor npm run start:vite:client\" \"meteor npm run start:vite:server\"",
    "start": "meteor npm run start:vite && concurrently -n start:meteor,start:vite:client,start:vite:server \"meteor npm run start:meteor\" \"meteor npm run start:vite:client -- --watch\" \"meteor npm run start:vite:server -- --watch\"",
    "build:vite:client": "TARGET=client vite build ---config=vite.config.js --mode=production",
    "build:vite:server": "TARGET=server vite build --config=vite.config.js --mode=production",
    "build:vite": "concurrently -n build:vite:client,build:vite:server \"meteor npm run build:vite:client\" \"meteor npm run build:vite:server\"",
    "build:meteor": "del-cli ./dist && meteor build --directory ./dist && meteor npm install --prefix ./dist/bundle/programs/server",
    "build": "meteor npm run build:vite && meteor npm run build:meteor",
    "build:force": "meteor npm run clean && meteor npm install && meteor npm run build",
    "eslint": "eslint . --fix",
    "prettier": "prettier --write \"**/*.js\" \"**/*.jsx\"",
    "clean": "del-cli '.meteor/local/*' '!.meteor/local/db' && del-cli 'node_modules'",
    "check": "npx @biomejs/biome check --write ./**/*.{js,jsx}",
    "visualize:vite": "ENABLE_BUNDLE_VISUALIZER=true meteor npm run build:vite",
    "visualize": "meteor npm run build:vite && concurrently --raw \"meteor npm run visualize:vite\" \"meteor --production --extra-packages bundle-visualizer\"",
    "deploy": "meteor npm run build:vite && meteor deploy"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.8",
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@hookform/resolvers": "^2.9.11",
    "@react-icons/all-files": "^4.1.0",
    "bcrypt": "^5.1.1",
    "framer-motion": "^6.5.1",
    "history": "^5.3.0",
    "lodash-es": "^4.17.21",
    "meteor-node-stubs": "^1.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.52.1",
    "react-router-dom": "^6.25.1",
    "shortscale": "^4.1.1",
    "simpl-schema": "^1.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@biomejs/biome": "1.8.3",
    "@quave/eslint-config-quave": "^1.0.7",
    "@rspack/cli": "^1.3.10",
    "@rspack/core": "^1.3.10",
    "@rspack/plugin-node-polyfill": "^0.5.8",
    "@swc/core": "^1.7.0",
    "@types/meteor": "^2.9.2",
    "@types/mocha": "^9.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^9.1.3",
    "chai": "^4.4.1",
    "concurrently": "^8.2.0",
    "del-cli": "^5.0.0",
    "esbuild-loader": "^4.2.2",
    "fkill-cli": "^7.1.0",
    "html-webpack-plugin": "^5.5.3",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-strip-code": "^0.2.8",
    "rollup-plugin-visualizer": "^6.0.1",
    "swc-loader": "^0.2.6",
    "vite": "^6.3.5"
  },
  "meteor": {
    "mainModule": {
      "client": "client/client.js",
      "server": "server/server.js"
    },
    "testModule": "tests/main.js",
    "modern": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "meteor npm test && lint-staged",
      "post-commit": "git update-index --again"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "biome check --files-ignore-unknown=true",
      "biome check --write --no-errors-on-unmatched",
      "biome check --write --organize-imports-enabled=false --no-errors-on-unmatched",
      "biome check --write --unsafe --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  }
}
